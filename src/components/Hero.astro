---
import { Image } from "astro:assets";
import startScreenshot from "../assets/screenshots/start.png";

const PLAY_URL = "https://app.pufferpower.com";
---

<section
  class="relative overflow-hidden"
  style="background: radial-gradient(circle at 50% 20%, var(--color-sea-deep), var(--color-sea) 70%);"
>
  <div
    class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 md:grid-cols-2 md:py-28"
  >
    <div>
      <p
        class="mb-4 inline-block rounded-full bg-white/70 px-4 py-1 text-sm font-bold text-title ring-1 ring-card-edge"
      >
        A sight-words game for kids
      </p>
      <h1 class="text-4xl font-extrabold leading-tight text-title sm:text-5xl">
        Help the puffer fish survive the shark.
      </h1>
      <p class="mt-6 text-lg text-ink/80">
        Puffer Power turns sight-word practice into a game your kid actually
        wants to play — no ads, no tracking, nothing else competing for
        their attention. Just reading practice, and a puffer fish that's
        counting on them.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href={PLAY_URL} class="btn-pill btn-primary px-8 py-4 text-lg">
          ▶ Play Now
        </a>
        <a
          href="#how-it-works"
          class="btn-pill px-6 py-4 text-lg font-bold text-title ring-2 ring-card-edge hover:bg-white/50"
        >
          See how it works
        </a>
      </div>
      <p class="mt-4 text-sm text-ink/60">
        Free to play at <span class="font-semibold">app.pufferpower.com</span>
        — works right in the browser, no download.
      </p>
    </div>

    <div class="mx-auto w-full max-w-md">
      <Image
        src={startScreenshot}
        alt="Puffer Power start screen with a Play button"
        width={720}
        class="rounded-3xl border-4 border-white shadow-2xl"
      />
    </div>
  </div>
</section>
